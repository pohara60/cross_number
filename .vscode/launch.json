{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Solve current puzzle file",
            "type": "dart",
            "request": "launch",
            "program": "bin/cross_number_v2.dart",
            "args": ["-p", "${fileBasenameNoExtension}"] //, "-t"] // , "-b"]
        },
        {
            "name": "Trace current puzzle file",
            "type": "dart",
            "request": "launch",
            "program": "bin/cross_number_v2.dart",
            "args": ["-p", "${fileBasenameNoExtension}", "-t", "-b"]
        },
        {
            "name": "Current file",
            "type": "dart",
            "request": "launch",
            "program": "${file}"
        }
    ]
}